{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bit-es/intranet",
    "type": "project",
    "description": "A Laravel-based subscription service application. Open for use by any company; data ownership remains with the subscribing company.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "bit-es/base": "dev-main",
        "bit-es/employment": "dev-main",
        "bit-es/knowledge": "dev-main",
        "bit-es/organization": "dev-main",
        "bit-es/service": "dev-main",
        "directorytree/ldaprecord-laravel": "^3.4",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "spatie/laravel-model-info": "^2.0",
        "spatie/laravel-permission": "^6.21"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/base",
            "options": {
                "symlink": true,
                "canonical": false
            }
        },
        {
            "type": "path",
            "url": "packages/employment",
            "options": {
                "symlink": true,
                "canonical": false
            }
        },
        {
            "type": "path",
            "url": "packages/knowledge",
            "options": {
                "symlink": true,
                "canonical": false
            }
        },
        {
            "type": "path",
            "url": "packages/organization",
            "options": {
                "symlink": true,
                "canonical": false
            }
        },
        {
            "type": "path",
            "url": "packages/service",
            "options": {
                "symlink": true,
                "canonical": false
            }
        }
    ],
    "require-dev": {
        "driftingly/rector-laravel": "^2.1",
        "fakerphp/faker": "^1.23",
        "filament/upgrade": "^5.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Bites\\CorpLogin\\": "packages/bit-es/corp-login/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "job-queue": [
            "@php artisan optimize:clear",
            "@php artisan optimize",
            "php artisan bites:fetch-ecology ecology.get_staff --store --source=MWSQLDBQ03.my.ds.amkor.com/ecology",
            "@php artisan queue:work --queue=weaver-seed --tries=3 --timeout=100"
        ],
        "job-seed": [
            "php artisan db:seed --class=MigrationSeeder",
            "@php artisan bites:make-permissions",
            "@upload"
        ],
        "upload": [
            "bash -lc 'set -e; cd /srv/intra; if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then echo \"[upload] Not a git repo.\"; exit 1; fi; if ! git diff --quiet || ! git diff --cached --quiet || [ -n \"$(git ls-files --others --exclude-standard)\" ]; then git add .; git commit -m \"chore: auto upload via composer ($(date -u +%Y-%m-%dT%H:%M:%SZ))\" || echo \"[upload] Nothing to commit (commit skipped)\"; git push; echo \"[upload] Pushed to origin\"; else echo \"[upload] No changes\"; fi'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}