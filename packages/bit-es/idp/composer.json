{
    "name": "bit-es/idp",
    "description": "Laravel Passport-based Identity Provider (IdP) package for Filament apps",
    "keywords": [
        "bit-es",
        "idp",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/bit-es/idp",
    "support": {
        "issues": "https://github.com/bit-es/idp/issues",
        "source": "https://github.com/bit-es/idp"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "bit-es",
            "email": "bit.ecosystem@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "laravel/passport": "^13.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Bites\\Idp\\": "src/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan migrate"
        ],
        "post-update-cmd": [],
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bites\\Idp\\IdpServiceProvider",
                "Bites\\Idp\\Providers\\IdpPanelProvider"
            ],
            "aliases": {
                "Idp": "Bites\\Idp\\Facades\\Idp"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}