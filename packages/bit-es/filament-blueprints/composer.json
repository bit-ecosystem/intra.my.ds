{
  "name": "bit-es/filament-blueprints",
  "description": "Blueprint-driven Filament form blocks with a pluggable registry and decoders.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2|^8.3",
    "filament/filament": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "Bites\\FilamentBlueprints\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bites\\FilamentBlueprints\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Bites\\FilamentBlueprints\\BlueprintServiceProvider"
      ]
    }
  },
    "minimum-stability": "dev",
    "prefer-stable": true
}