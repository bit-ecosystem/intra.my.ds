{
    "name": "bit-es/corp-login",
    "description": "Corp login package includes Filament auth pages and assets.",
    "type": "library",
    "homepage": "https://github.com/bit-es/idp",
    "support": {
        "issues": "https://github.com/bit-es/idp/issues",
        "source": "https://github.com/bit-es/idp"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "bit-es",
            "email": "bit.ecosystem@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "dutchcodingcompany/filament-socialite": "^3.0",
        "filament/upgrade": "^5.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Bites\\CorpLogin\\": "src/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan migrate"
        ],
        "post-update-cmd": [],
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bites\\CorpLogin\\CorpLoginServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}