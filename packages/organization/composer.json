{
    "name": "bit-es/organization",
    "description": "Core domain package providing identity, organization structure, and authorization logic.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BIT Ecosystem",
            "email": "bit.ecosystem@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "bit-es/service": "*",
        "laravel/passport": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Bites\\Organization\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bites\\Organization\\OrganizationServiceProvider",
                "Bites\\Organization\\Providers\\IdpPanelProvider"
